# Copy this file to ".env" and fill in at least one key.
# Gemini is tried first, Groq is the fallback.

GEMINI_API_KEY=
GROQ_API_KEY=

# Optional: models are tried in order. Model names get retired over time -
# if an answer fails with a 404, update these lists.
# GEMINI_MODELS=gemini-3.8-flash,gemini-flash-latest
# GROQ_MODELS=llama-3.3-70b-versatile,llama-3.1-8b-instant

# Speech-to-text (faster-whisper, runs locally).
# tiny / base = faster multilingual models, small = higher accuracy.
# WHISPER_MODEL=base
# WHISPER_DEVICE=auto          # auto | cpu | cuda
# WHISPER_COMPUTE_TYPE=auto    # auto | int8 | float16
# WHISPER_LANGUAGE=en          # leave empty for auto-detect (use a multilingual model, e.g. "small")

# How long a pause (ms) ends the interviewer's sentence.
# SILENCE_MS=750
# Number of previous Q/A pairs kept in memory for follow-up questions.
# HISTORY_TURNS=6
